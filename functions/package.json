{
  "name": "fastdo-attend-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "test": "npm run build && node --test test/**/*.test.cjs",
    "test:emulators": "node scripts/smoke-emulators.cjs"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
