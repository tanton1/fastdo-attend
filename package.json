{
  "name": "fastdo-attend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "start:sites": "vinext start",
    "test": "npm run build:sites && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:functions": "npm --prefix functions test",
    "firebase:deploy:core": "firebase deploy --project fastdo-attend-2026 --only auth,firestore:rules,firestore:indexes",
    "firebase:deploy:functions": "firebase deploy --project fastdo-attend-2026 --only functions",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@vladmandic/face-api": "1.7.15",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.3.0",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
